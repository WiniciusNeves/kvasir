{
  "name": "kvasir",
  "version": "0.1.0",
  "description": "Kvasir — modular productivity ecosystem CLI for developers",
  "author": "WiniciusNeves",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/cli/index.js",
  "bin": {
    "kvasir": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "dev": "ts-node -r tsconfig-paths/register src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "axios": "^1.7.9",
    "clipboardy": "^5.3.2",
    "commander": "^15.0.0",
    "cosmiconfig": "^9.0.0",
    "fs-extra": "^11.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
